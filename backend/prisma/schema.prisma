generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id Int @id @default(autoincrement())
  name String
  employees Employee[]
}

model Employee {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  departmentId Int
  department Department @relation(fields: [departmentId], references: [id])
}

model Role {
  id Int @id @default(autoincrement())
  firstName String
  lastName String
  roleName String
}